---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404: Offside - FIFA Math" description="VAR is checking the URL. The page you are looking for does not exist.">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4">
    <div class="text-6xl font-black text-slate-700 mb-4 tracking-tighter">404</div>
    <h1 class="text-4xl font-bold text-white mb-6">Offside! VAR is checking the URL...</h1>
    
    <div class="max-w-md mx-auto bg-slate-800 border border-slate-700 rounded-xl p-6 mb-8 shadow-2xl relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500 via-yellow-500 to-red-500"></div>
      <p class="text-slate-300 text-lg mb-4">
        The statistical anomaly you're looking for doesn't exist, or it has been mathematically disproven.
      </p>
      
      <div class="flex items-center justify-center space-x-2 text-sm text-slate-400 font-mono bg-slate-900 p-3 rounded">
        <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Expected Threat (xT) = 0.00</span>
      </div>
    </div>
    
    <a href="/" class="group inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-blue-600 hover:bg-blue-500 rounded-lg transition-all shadow-lg hover:shadow-blue-500/25">
      <svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Return to the Pitch
    </a>
  </div>
</BaseLayout>
