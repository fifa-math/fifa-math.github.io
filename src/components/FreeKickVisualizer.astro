---
// src/components/FreeKickVisualizer.astro
---
<div id="freekick-container" class="w-full h-[400px] border border-gray-200 rounded-lg bg-slate-800 relative">
</div>

<script>
  import * as d3 from 'd3';

  const container = document.getElementById('freekick-container');
  
  if (container) {
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      const margin = {top: 40, right: 30, bottom: 50, left: 60};
      
      const innerWidth = width - margin.left - margin.right;
      const innerHeight = height - margin.top - margin.bottom;

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // Data: Distance to Goal (Yards) vs Conversion Rate (%)
      // Conversion peaks around 22-24 yards, too close means no space over the wall, too far means too much time to react
      const data = [
        { distance: 18, rate: 3.5 },
        { distance: 19, rate: 5.2 },
        { distance: 20, rate: 7.8 },
        { distance: 21, rate: 10.1 },
        { distance: 22, rate: 12.4 }, // Peak
        { distance: 23, rate: 11.8 },
        { distance: 24, rate: 9.5 },
        { distance: 25, rate: 7.2 },
        { distance: 26, rate: 5.4 },
        { distance: 27, rate: 4.1 },
        { distance: 28, rate: 3.0 },
        { distance: 30, rate: 1.8 },
        { distance: 35, rate: 0.5 },
        { distance: 40, rate: 0.1 }
      ];

      const x = d3.scaleLinear()
        .domain([18, 40])
        .range([0, innerWidth]);

      const y = d3.scaleLinear()
        .domain([0, 15])
        .range([innerHeight, 0]);

      // X Axis
      svg.append("g")
        .attr("transform", `translate(0,${innerHeight})`)
        .call(d3.axisBottom(x).tickFormat(d => d + " yds"))
        .attr("color", "#94a3b8");

      svg.append("text")
        .attr("x", innerWidth / 2)
        .attr("y", innerHeight + 40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Distance to Goal (Yards)");

      // Y Axis
      svg.append("g")
        .call(d3.axisLeft(y).tickFormat(d => d + "%"))
        .attr("color", "#94a3b8");

      svg.append("text")
        .attr("transform", "rotate(-90)")
        .attr("x", -innerHeight / 2)
        .attr("y", -40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Conversion Rate (%)");

      // Area
      const area = d3.area<any>()
        .x(d => x(d.distance))
        .y0(innerHeight)
        .y1(d => y(d.rate))
        .curve(d3.curveMonotoneX);

      // Defs for gradient
      const defs = svg.append("defs");
      const gradient = defs.append("linearGradient")
        .attr("id", "area-gradient")
        .attr("x1", "0%").attr("y1", "0%")
        .attr("x2", "0%").attr("y2", "100%");
      gradient.append("stop").attr("offset", "0%").attr("stop-color", "#ec4899").attr("stop-opacity", 0.6);
      gradient.append("stop").attr("offset", "100%").attr("stop-color", "#ec4899").attr("stop-opacity", 0.1);

      svg.append("path")
        .datum(data)
        .attr("fill", "url(#area-gradient)")
        .attr("d", area)
        .style("opacity", 0)
        .transition()
        .duration(1500)
        .style("opacity", 1);

      // Line
      const line = d3.line<any>()
        .x(d => x(d.distance))
        .y(d => y(d.rate))
        .curve(d3.curveMonotoneX);

      const pathLine = svg.append("path")
        .datum(data)
        .attr("fill", "none")
        .attr("stroke", "#ec4899")
        .attr("stroke-width", 3)
        .attr("d", line);
        
      const length = pathLine.node().getTotalLength();
      pathLine.attr("stroke-dasharray", length + " " + length)
          .attr("stroke-dashoffset", length)
          .transition()
          .duration(1500)
          .ease(d3.easeCubicOut)
          .attr("stroke-dashoffset", 0);
          
      // Highlight optimal distance
      svg.append("circle")
        .attr("cx", x(22))
        .attr("cy", y(12.4))
        .attr("r", 6)
        .attr("fill", "#22c55e")
        .style("opacity", 0)
        .transition()
        .delay(1000)
        .duration(500)
        .style("opacity", 1);
        
      svg.append("line")
        .attr("x1", x(22))
        .attr("y1", y(12.4))
        .attr("x2", x(22))
        .attr("y2", innerHeight)
        .attr("stroke", "#22c55e")
        .attr("stroke-dasharray", "4,4")
        .style("opacity", 0)
        .transition()
        .delay(1000)
        .duration(500)
        .style("opacity", 1);
        
      svg.append("text")
        .attr("x", x(22))
        .attr("y", y(12.4) - 20)
        .attr("fill", "#22c55e")
        .attr("text-anchor", "middle")
        .style("font-size", "14px")
        .text("Optimal Distance (22 yds)")
        .style("opacity", 0)
        .transition()
        .delay(1000)
        .duration(500)
        .style("opacity", 1);
    }
  }
</script>
