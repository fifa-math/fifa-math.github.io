---
// src/components/PitchControlVisualizer.astro
---
<div class="pitch-control-container" role="figure" aria-label="Pitch Control Voronoi Visualization" class="w-full h-[500px] border border-gray-200 rounded-lg bg-green-800 relative flex flex-col items-center overflow-hidden">
  
  <div class="absolute top-4 left-4 z-10 bg-slate-900/80 p-3 rounded-lg border border-slate-700 pointer-events-none">
    <div class="text-sm text-gray-300 font-bold mb-1">Voronoi Pitch Control</div>
    <div class="flex items-center">
      <div class="w-3 h-3 bg-red-500 rounded-full mr-2"></div>
      <div class="text-xs text-white">Red Team Control</div>
    </div>
    <div class="flex items-center mt-1">
      <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
      <div class="text-xs text-white">Blue Team Control</div>
    </div>
    <div class="text-xs text-green-400 mt-2">Drag players to shift control zones</div>
  </div>

  <div id="voronoi-pitch" class="w-full h-full relative"></div>
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.pitch-control-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const pitchArea = container.querySelector('#voronoi-pitch');
      if (!pitchArea) return;

      const width = pitchArea.clientWidth;
      const height = pitchArea.clientHeight;

      const svg = d3.select(pitchArea)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`);

      // Pitch lines
      svg.append("rect")
        .attr("x", 0).attr("y", 0).attr("width", width).attr("height", height)
        .attr("fill", "#166534");
        
      svg.append("line").attr("x1", width/2).attr("y1", 0).attr("x2", width/2).attr("y2", height)
        .attr("stroke", "rgba(255,255,255,0.4)").attr("stroke-width", 2);
      
      svg.append("circle").attr("cx", width/2).attr("cy", height/2).attr("r", 50)
        .attr("stroke", "rgba(255,255,255,0.4)").attr("stroke-width", 2).attr("fill", "none");

      // Generate players
      // 5 Red, 5 Blue
      const players: {id: number, team: 'red' | 'blue', x: number, y: number}[] = [];
      
      // Initialize spread out
      for (let i = 0; i < 5; i++) {
        players.push({ id: i, team: 'red', x: width * 0.2 + (Math.random() * width * 0.2), y: height * 0.1 + (i * height * 0.15) });
      }
      for (let i = 5; i < 10; i++) {
        players.push({ id: i, team: 'blue', x: width * 0.6 + (Math.random() * width * 0.2), y: height * 0.1 + ((i-5) * height * 0.15) });
      }

      const voronoiGroup = svg.append("g").attr("class", "voronoi-paths");
      const playerGroup = svg.append("g").attr("class", "players");

      function update() {
        // Compute Delaunay
        const points = players.map(p => [p.x, p.y]);
        const delaunay = d3.Delaunay.from(points);
        const voronoi = delaunay.voronoi([0, 0, width, height]);

        // Draw cells
        const paths = voronoiGroup.selectAll("path")
          .data(players, (d: any) => d.id);

        paths.enter()
          .append("path")
          .merge(paths as any)
          .attr("d", (d, i) => voronoi.renderCell(i))
          .attr("fill", d => d.team === 'red' ? 'rgba(239, 68, 68, 0.4)' : 'rgba(59, 130, 246, 0.4)')
          .attr("stroke", "rgba(255,255,255,0.2)")
          .attr("stroke-width", 1);

        // Draw players
        const circles = playerGroup.selectAll("circle")
          .data(players, (d: any) => d.id);
          
        circles.enter()
          .append("circle")
          .attr("r", 10)
          .attr("stroke", "#ffffff")
          .attr("stroke-width", 2)
          .attr("cursor", "grab")
          .merge(circles as any)
          .attr("cx", d => d.x)
          .attr("cy", d => d.y)
          .attr("fill", d => d.team === 'red' ? '#ef4444' : '#3b82f6')
          .call(d3.drag<SVGCircleElement, any>()
            .on("start", function() {
              d3.select(this).attr("cursor", "grabbing");
            })
            .on("drag", (event, d) => {
              d.x = Math.max(0, Math.min(width, event.x));
              d.y = Math.max(0, Math.min(height, event.y));
              update();
            })
            .on("end", function() {
              d3.select(this).attr("cursor", "grab");
            }) as any);
      }

      update();
    }
  });
</script>
