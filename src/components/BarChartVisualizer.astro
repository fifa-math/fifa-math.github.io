---
// src/components/BarChartVisualizer.astro
---
<div class="barchart-container w-full h-[400px] border border-gray-200 rounded-lg bg-slate-800 relative" role="figure" aria-label="BarChartVisualizer Data Visualization">
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.barchart-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      const margin = {top: 40, right: 30, bottom: 50, left: 60};
      
      const innerWidth = width - margin.left - margin.right;
      const innerHeight = height - margin.top - margin.bottom;

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // Data representing percentage of goals scored by pass sequence length (right-skewed)
      const data = [
        { passes: "0-1", percentage: 15 },
        { passes: "2-3", percentage: 40 },
        { passes: "4-5", percentage: 20 },
        { passes: "6-7", percentage: 12 },
        { passes: "8-9", percentage: 8 },
        { passes: "10+", percentage: 5 }
      ];

      const x = d3.scaleBand()
        .domain(data.map(d => d.passes))
        .range([0, innerWidth])
        .padding(0.2);

      const y = d3.scaleLinear()
        .domain([0, 50])
        .range([innerHeight, 0]);

      // X Axis
      svg.append("g")
        .attr("transform", `translate(0,${innerHeight})`)
        .call(d3.axisBottom(x))
        .attr("color", "#94a3b8")
        .selectAll("text")
        .attr("font-size", "14px");

      svg.append("text")
        .attr("x", innerWidth / 2)
        .attr("y", innerHeight + 40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Number of Passes Before Goal");

      // Y Axis
      svg.append("g")
        .call(d3.axisLeft(y).tickFormat(d => d + "%"))
        .attr("color", "#94a3b8");

      svg.append("text")
        .attr("transform", "rotate(-90)")
        .attr("x", -innerHeight / 2)
        .attr("y", -40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Percentage of Total Goals");

      // Bars
      svg.selectAll("mybar")
        .data(data)
        .enter()
        .append("rect")
        .attr("x", d => x(d.passes)!)
        .attr("width", x.bandwidth())
        .attr("fill", "#3b82f6")
        // No bar at the beginning
        .attr("height", d => innerHeight - y(0)) 
        .attr("y", d => y(0))
        .transition()
        .duration(800)
        .delay((d, i) => i * 100)
        .attr("y", d => y(d.percentage))
        .attr("height", d => innerHeight - y(d.percentage));
        
      // Labels on top
      svg.selectAll("mylabels")
        .data(data)
        .enter()
        .append("text")
        .attr("x", d => x(d.passes)! + x.bandwidth() / 2)
        .attr("y", d => y(d.percentage) - 5)
        .attr("text-anchor", "middle")
        .text(d => d.percentage + "%")
        .attr("fill", "#ffffff")
        .style("opacity", 0)
        .transition()
        .duration(800)
        .delay((d, i) => i * 100 + 400)
        .style("opacity", 1);
    }
  });
</script>
