---
// src/components/ReactionVisualizer.astro
---
<div class="reaction-container" role="figure" aria-label="ReactionVisualizer Data Visualization" class="w-full h-[400px] border border-gray-200 rounded-lg bg-slate-800 relative">
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.reaction-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      const margin = {top: 40, right: 30, bottom: 50, left: 60};
      
      const innerWidth = width - margin.left - margin.right;
      const innerHeight = height - margin.top - margin.bottom;

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // Data: Saves made by Anticipation (Guessing) vs Reaction
      // Categories: Correct Direction, Incorrect Direction, Center
      const data = [
        { category: "Saved", Anticipation: 85, Reaction: 15 },
        { category: "Scored", Anticipation: 70, Reaction: 30 },
      ];

      const subgroups = ["Anticipation", "Reaction"];
      const groups = data.map(d => d.category);

      const x = d3.scaleBand()
        .domain(groups)
        .range([0, innerWidth])
        .padding(0.2);

      const xSubgroup = d3.scaleBand()
        .domain(subgroups)
        .range([0, x.bandwidth()])
        .padding(0.05);

      const y = d3.scaleLinear()
        .domain([0, 100])
        .range([innerHeight, 0]);

      const color = d3.scaleOrdinal<string>()
        .domain(subgroups)
        .range(["#f59e0b", "#3b82f6"]);

      // X Axis
      svg.append("g")
        .attr("transform", `translate(0,${innerHeight})`)
        .call(d3.axisBottom(x))
        .attr("color", "#94a3b8")
        .selectAll("text")
        .attr("font-size", "14px");

      // Y Axis
      svg.append("g")
        .call(d3.axisLeft(y).tickFormat(d => d + "%"))
        .attr("color", "#94a3b8");

      svg.append("text")
        .attr("transform", "rotate(-90)")
        .attr("x", -innerHeight / 2)
        .attr("y", -40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Percentage of Total Actions");

      // Draw Bars
      svg.append("g")
        .selectAll("g")
        .data(data)
        .enter()
        .append("g")
        .attr("transform", d => `translate(${x(d.category)},0)`)
        .selectAll("rect")
        .data(d => subgroups.map(key => ({key, value: d[key as keyof typeof d] as number})))
        .enter()
        .append("rect")
        .attr("x", d => xSubgroup(d.key)!)
        .attr("width", xSubgroup.bandwidth())
        .attr("fill", d => color(d.key))
        .attr("y", innerHeight)
        .attr("height", 0)
        .transition()
        .duration(1000)
        .delay((d, i) => i * 200)
        .attr("y", d => y(d.value))
        .attr("height", d => innerHeight - y(d.value));

      // Labels on bars
      svg.append("g")
        .selectAll("g")
        .data(data)
        .enter()
        .append("g")
        .attr("transform", d => `translate(${x(d.category)},0)`)
        .selectAll("text")
        .data(d => subgroups.map(key => ({key, value: d[key as keyof typeof d] as number})))
        .enter()
        .append("text")
        .attr("x", d => xSubgroup(d.key)! + xSubgroup.bandwidth() / 2)
        .attr("y", d => y(d.value) - 5)
        .attr("text-anchor", "middle")
        .text(d => d.value + "%")
        .attr("fill", "#ffffff")
        .style("opacity", 0)
        .transition()
        .duration(1000)
        .delay((d, i) => i * 200 + 500)
        .style("opacity", 1);

      // Legend
      const legend = svg.append("g").attr("transform", `translate(${innerWidth - 120}, 0)`);
      
      legend.append("rect").attr("x", 0).attr("y", 0).attr("width", 10).attr("height", 10).attr("fill", "#f59e0b");
      legend.append("text").attr("x", 15).attr("y", 10).text("Anticipation (Guessing)").attr("fill", "#cbd5e1").style("font-size", "12px");
      
      legend.append("rect").attr("x", 0).attr("y", 20).attr("width", 10).attr("height", 10).attr("fill", "#3b82f6");
      legend.append("text").attr("x", 15).attr("y", 30).text("Reaction (Waiting)").attr("fill", "#cbd5e1").style("font-size", "12px");
    }
  });
</script>
