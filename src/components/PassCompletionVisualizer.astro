---
// src/components/PassCompletionVisualizer.astro
---
<div class="pass-xt-container" role="figure" aria-label="Pass Completion Expected Threat Visualization" class="w-full h-[500px] border border-gray-200 rounded-lg bg-green-800 relative flex flex-col items-center overflow-hidden">
  <div class="absolute top-4 left-4 z-10 flex flex-col space-y-2 bg-slate-900/80 p-3 rounded-lg border border-slate-700">
    <div class="text-white font-bold mb-2">Expected Threat (xT)</div>
    <button id="btn-backward" class="px-3 py-1 bg-slate-700 hover:bg-slate-600 text-white text-sm font-semibold rounded text-left transition-colors flex justify-between">
      <span>Backward Pass</span> <span class="text-red-400 font-mono ml-4">-0.05 xT</span>
    </button>
    <button id="btn-forward" class="px-3 py-1 bg-slate-700 hover:bg-slate-600 text-white text-sm font-semibold rounded text-left transition-colors flex justify-between">
      <span>Through Ball</span> <span class="text-green-400 font-mono ml-4">+0.45 xT</span>
    </button>
  </div>
  
  <div class="absolute top-4 right-4 z-10 bg-slate-900/80 p-2 rounded border border-slate-700">
    <div class="text-xs text-gray-400 mb-1">xT Heatmap</div>
    <div class="flex items-center space-x-1">
      <div class="w-4 h-4 bg-red-500/20"></div>
      <div class="text-xs text-white">Low</div>
      <div class="w-4 h-4 bg-yellow-500/50 mx-1"></div>
      <div class="w-4 h-4 bg-green-500/80"></div>
      <div class="text-xs text-white">High</div>
    </div>
  </div>

  <div id="xt-pitch" class="w-full h-full relative"></div>
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.pass-xt-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const pitchArea = container.querySelector('#xt-pitch');
      if (!pitchArea) return;

      const width = pitchArea.clientWidth;
      const height = pitchArea.clientHeight;

      const svg = d3.select(pitchArea)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`);

      // Draw Grid (10x10)
      const cols = 10;
      const rows = 10;
      const cellW = width / cols;
      const cellH = height / rows;

      // Create a gradient heatmap effect for xT
      // Attack is going Right to Left (or Bottom to Top, let's say Bottom to Top)
      // Goal is at y=0.
      const grid = svg.append("g").attr("class", "grid");

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          // High xT near top center (y=0, x=width/2)
          const distToGoal = Math.sqrt(Math.pow(i - 4.5, 2) + Math.pow(j, 2));
          // Normalize 0 to 1
          const xt = Math.max(0, 1 - (distToGoal / 8));
          
          let color = "rgba(239, 68, 68, 0.1)"; // Red/low
          if (xt > 0.4 && xt <= 0.7) color = "rgba(234, 179, 8, 0.4)"; // Yellow/med
          if (xt > 0.7) color = "rgba(34, 197, 94, 0.6)"; // Green/high
          
          grid.append("rect")
            .attr("x", i * cellW)
            .attr("y", j * cellH)
            .attr("width", cellW)
            .attr("height", cellH)
            .attr("fill", color)
            .attr("stroke", "rgba(255,255,255,0.1)");
        }
      }

      // Draw Goal at top
      svg.append("rect")
        .attr("x", width / 2 - 40)
        .attr("y", 0)
        .attr("width", 80)
        .attr("height", 10)
        .attr("fill", "white");

      // Draw lines
      // Start position (midfield)
      const startX = width / 2;
      const startY = height * 0.7;

      // Define arrows
      svg.append("defs").append("marker")
        .attr("id", "arrow")
        .attr("viewBox", "0 0 10 10")
        .attr("refX", 5)
        .attr("refY", 5)
        .attr("markerWidth", 6)
        .attr("markerHeight", 6)
        .attr("orient", "auto-start-reverse")
        .append("path")
        .attr("d", "M 0 0 L 10 5 L 0 10 z")
        .attr("fill", "white");

      const passLine = svg.append("line")
        .attr("x1", startX)
        .attr("y1", startY)
        .attr("x2", startX)
        .attr("y2", startY)
        .attr("stroke", "white")
        .attr("stroke-width", 3)
        .attr("stroke-dasharray", "5,5")
        .attr("marker-end", "url(#arrow)");

      const player = svg.append("circle")
        .attr("cx", startX)
        .attr("cy", startY)
        .attr("r", 8)
        .attr("fill", "white")
        .attr("stroke", "#1e293b")
        .attr("stroke-width", 2);

      const btnBackward = container.querySelector('#btn-backward');
      const btnForward = container.querySelector('#btn-forward');

      function animatePass(endX: number, endY: number, color: string) {
        passLine
          .attr("x2", startX)
          .attr("y2", startY)
          .attr("stroke", color)
          .transition()
          .duration(800)
          .attr("x2", endX)
          .attr("y2", endY);
      }

      btnBackward?.addEventListener('click', () => {
        animatePass(startX - 50, startY + 100, "#f87171"); // Backwards
        btnBackward.classList.replace('bg-slate-700', 'bg-blue-600');
        btnBackward.classList.replace('hover:bg-slate-600', 'hover:bg-blue-500');
        btnForward?.classList.replace('bg-blue-600', 'bg-slate-700');
        btnForward?.classList.replace('hover:bg-blue-500', 'hover:bg-slate-600');
      });

      btnForward?.addEventListener('click', () => {
        animatePass(width / 2 + 30, height * 0.2, "#4ade80"); // Through ball into box
        btnForward.classList.replace('bg-slate-700', 'bg-blue-600');
        btnForward.classList.replace('hover:bg-slate-600', 'hover:bg-blue-500');
        btnBackward?.classList.replace('bg-blue-600', 'bg-slate-700');
        btnBackward?.classList.replace('hover:bg-blue-500', 'hover:bg-slate-600');
      });

      // Initial
      setTimeout(() => {
        btnForward?.click();
      }, 500);
    }
  });
</script>
