---
// src/components/PPDAVisualizer.astro
---
<div class="ppda-container" role="figure" aria-label="PPDA Pressing Intensity Visualization" class="w-full h-[400px] border border-gray-200 rounded-lg bg-slate-800 relative flex flex-col items-center">
  <div class="absolute top-4 left-4 z-10 bg-slate-900/80 p-3 rounded-lg border border-slate-700 pointer-events-none">
    <div class="text-sm text-gray-300">Match Fatigue: PPDA Timeline</div>
    <div class="flex items-center mt-2">
      <div class="w-3 h-3 bg-red-500 rounded-full mr-2"></div>
      <div class="text-xs text-white">High Pressing Team</div>
    </div>
    <div class="flex items-center mt-1">
      <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
      <div class="text-xs text-white">Low Block Team</div>
    </div>
  </div>

  <div id="ppda-chart" class="w-full h-full relative"></div>
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.ppda-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const chartArea = container.querySelector('#ppda-chart');
      if (!chartArea) return;

      const width = chartArea.clientWidth;
      const height = chartArea.clientHeight;
      const margin = { top: 60, right: 30, bottom: 40, left: 50 };
      const innerW = width - margin.left - margin.right;
      const innerH = height - margin.top - margin.bottom;

      const svg = d3.select(chartArea)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // Data: Minute (0-90) and PPDA (Passes Per Defensive Action)
      // Lower PPDA = higher intensity
      const highPressData = [
        { minute: 0, ppda: 6.5 },
        { minute: 15, ppda: 6.8 },
        { minute: 30, ppda: 7.2 },
        { minute: 45, ppda: 8.5 },
        { minute: 60, ppda: 9.1 },
        { minute: 75, ppda: 11.5 },
        { minute: 90, ppda: 14.2 }, // Fatigue sets in
      ];

      const lowBlockData = [
        { minute: 0, ppda: 15.5 },
        { minute: 15, ppda: 16.0 },
        { minute: 30, ppda: 15.2 },
        { minute: 45, ppda: 15.8 },
        { minute: 60, ppda: 16.5 },
        { minute: 75, ppda: 16.2 },
        { minute: 90, ppda: 17.0 },
      ];

      const xScale = d3.scaleLinear()
        .domain([0, 90])
        .range([0, innerW]);

      // Note: Y axis is inverted logically for the user. We want 0 at bottom, 20 at top.
      const yScale = d3.scaleLinear()
        .domain([0, 20])
        .range([innerH, 0]);

      // X Axis
      svg.append("g")
        .attr("transform", `translate(0,${innerH})`)
        .call(d3.axisBottom(xScale).tickValues([0, 15, 30, 45, 60, 75, 90]).tickFormat(d => d + "'"))
        .attr("color", "#94a3b8");

      // Y Axis
      svg.append("g")
        .call(d3.axisLeft(yScale).ticks(5))
        .attr("color", "#94a3b8");

      // Y Axis Label
      svg.append("text")
        .attr("transform", "rotate(-90)")
        .attr("y", -35)
        .attr("x", -innerH / 2)
        .attr("text-anchor", "middle")
        .style("fill", "#94a3b8")
        .style("font-size", "12px")
        .text("PPDA (Passes Allowed)");

      // Annotations
      svg.append("text").attr("x", innerW - 10).attr("y", yScale(5)).style("fill", "rgba(74, 222, 128, 0.5)").style("font-size", "10px").attr("text-anchor", "end").text("Intense Pressing Zone");
      svg.append("text").attr("x", innerW - 10).attr("y", yScale(18)).style("fill", "rgba(148, 163, 184, 0.5)").style("font-size", "10px").attr("text-anchor", "end").text("Passive Zone");

      // Background zones
      svg.append("rect").attr("x", 0).attr("y", yScale(10)).attr("width", innerW).attr("height", innerH - yScale(10)).attr("fill", "rgba(74, 222, 128, 0.05)");

      const lineGenerator = d3.line<any>()
        .x(d => xScale(d.minute))
        .y(d => yScale(d.ppda))
        .curve(d3.curveMonotoneX);

      // Draw high press line
      const path1 = svg.append("path")
        .datum(highPressData)
        .attr("fill", "none")
        .attr("stroke", "#ef4444")
        .attr("stroke-width", 3)
        .attr("d", lineGenerator);

      // Draw low block line
      const path2 = svg.append("path")
        .datum(lowBlockData)
        .attr("fill", "none")
        .attr("stroke", "#3b82f6")
        .attr("stroke-width", 3)
        .attr("d", lineGenerator);

      // Animation
      const animatePath = (path: any) => {
        const length = path.node().getTotalLength();
        path.attr("stroke-dasharray", length + " " + length)
          .attr("stroke-dashoffset", length)
          .transition()
          .duration(2000)
          .ease(d3.easeLinear)
          .attr("stroke-dashoffset", 0);
      };

      animatePath(path1);
      animatePath(path2);

      // Add circles
      svg.selectAll(".dot1")
        .data(highPressData)
        .enter().append("circle")
        .attr("class", "dot1")
        .attr("cx", d => xScale(d.minute))
        .attr("cy", d => yScale(d.ppda))
        .attr("r", 4)
        .attr("fill", "#ef4444")
        .style("opacity", 0)
        .transition().delay((d, i) => i * (2000/7)).duration(100)
        .style("opacity", 1);
        
      svg.selectAll(".dot2")
        .data(lowBlockData)
        .enter().append("circle")
        .attr("class", "dot2")
        .attr("cx", d => xScale(d.minute))
        .attr("cy", d => yScale(d.ppda))
        .attr("r", 4)
        .attr("fill", "#3b82f6")
        .style("opacity", 0)
        .transition().delay((d, i) => i * (2000/7)).duration(100)
        .style("opacity", 1);
    }
  });
</script>
