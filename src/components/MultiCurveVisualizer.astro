---
// src/components/MultiCurveVisualizer.astro
---
<div class="multicurve-container" role="figure" aria-label="MultiCurveVisualizer Data Visualization" class="w-full h-[400px] border border-gray-200 rounded-lg bg-slate-800 relative overflow-hidden">
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.multicurve-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      const margin = {top: 40, right: 30, bottom: 50, left: 60};
      
      const innerWidth = width - margin.left - margin.right;
      const innerHeight = height - margin.top - margin.bottom;

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // X-axis: 0 to 80 (representing thousands of fans)
      const data = d3.range(1, 81).map(fans => {
        // Logarithmic Curve (Raw number of fans) -> Returns diminish quickly
        const logEnjoyment = Math.log10(fans) * 40; 
        
        // Exponential Curve (Capacity percentage). 
        // Assuming this stadium holds 20k, so at 20 fans, it's 100% full.
        // Let's model a 20k stadium vs 80k stadium.
        // We'll chart 10k fans in a 10k stadium vs 10k fans in an 80k stadium.
        // To simplify, let's just show two abstract curves for "Raw Volume" vs "Density"
        const density = Math.pow((fans / 80), 2) * 100;
        
        return { fans, logEnjoyment: Math.min(100, logEnjoyment), density };
      });

      const x = d3.scaleLinear()
        .domain([0, 80])
        .range([0, innerWidth]);

      const y = d3.scaleLinear()
        .domain([0, 100])
        .range([innerHeight, 0]);

      // X Axis
      svg.append("g")
        .attr("transform", `translate(0,${innerHeight})`)
        .call(d3.axisBottom(x))
        .attr("color", "#94a3b8");

      svg.append("text")
        .attr("x", innerWidth / 2)
        .attr("y", innerHeight + 40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Number of Fans (Thousands)");

      // Y Axis
      svg.append("g")
        .call(d3.axisLeft(y).tickFormat(d => d + "%"))
        .attr("color", "#94a3b8");

      svg.append("text")
        .attr("transform", "rotate(-90)")
        .attr("x", -innerHeight / 2)
        .attr("y", -40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Perceived Atmosphere Quality");

      // Line generators
      const lineLog = d3.line<any>().x(d => x(d.fans)).y(d => y(d.logEnjoyment)).curve(d3.curveMonotoneX);
      const lineExp = d3.line<any>().x(d => x(d.fans)).y(d => y(d.density)).curve(d3.curveMonotoneX);

      // Draw paths with animation
      const pathLog = svg.append("path")
        .datum(data)
        .attr("fill", "none")
        .attr("stroke", "#3b82f6") // Blue for Volume
        .attr("stroke-width", 3)
        .attr("d", lineLog);
        
      const pathExp = svg.append("path")
        .datum(data)
        .attr("fill", "none")
        .attr("stroke", "#ec4899") // Pink for Density
        .attr("stroke-width", 3)
        .attr("d", lineExp);

      // Animate paths
      [pathLog, pathExp].forEach(path => {
        const length = path.node().getTotalLength();
        path.attr("stroke-dasharray", length + " " + length)
            .attr("stroke-dashoffset", length)
            .transition()
            .duration(2000)
            .ease(d3.easeCubicOut)
            .attr("stroke-dashoffset", 0);
      });

      // Legend
      const legend = svg.append("g").attr("transform", `translate(20, 20)`);
      
      legend.append("rect").attr("x", 0).attr("y", 0).attr("width", 10).attr("height", 10).attr("fill", "#3b82f6");
      legend.append("text").attr("x", 15).attr("y", 10).text("Logarithmic (Raw Volume)").attr("fill", "#cbd5e1").style("font-size", "12px");
      
      legend.append("rect").attr("x", 0).attr("y", 20).attr("width", 10).attr("height", 10).attr("fill", "#ec4899");
      legend.append("text").attr("x", 15).attr("y", 30).text("Exponential (Density/Capacity)").attr("fill", "#cbd5e1").style("font-size", "12px");
    }
  });
</script>
