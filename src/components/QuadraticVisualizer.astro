---
// src/components/QuadraticVisualizer.astro
---
<div id="quadratic-container" class="w-full h-[400px] border border-gray-200 rounded-lg bg-slate-800 relative">
</div>

<script>
  import * as d3 from 'd3';

  const container = document.getElementById('quadratic-container');
  
  if (container) {
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      const margin = {top: 40, right: 30, bottom: 50, left: 60};
      
      const innerWidth = width - margin.left - margin.right;
      const innerHeight = height - margin.top - margin.bottom;

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // Quadratic curve data: Win Probability vs Average Squad Age
      // Peak around 27.5 years old
      const a = -1.5;
      const h = 27.5;
      const k = 85; // Peak win probability index
      
      const data = d3.range(20, 36).map(age => {
        const winProb = a * Math.pow((age - h), 2) + k;
        return { age, winProb: Math.max(0, winProb) };
      });

      const x = d3.scaleLinear()
        .domain([20, 35])
        .range([0, innerWidth]);

      const y = d3.scaleLinear()
        .domain([0, 100])
        .range([innerHeight, 0]);

      // X Axis
      svg.append("g")
        .attr("transform", `translate(0,${innerHeight})`)
        .call(d3.axisBottom(x).tickFormat(d => d + " yrs"))
        .attr("color", "#94a3b8");

      svg.append("text")
        .attr("x", innerWidth / 2)
        .attr("y", innerHeight + 40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Average Squad Age");

      // Y Axis
      svg.append("g")
        .call(d3.axisLeft(y).tickFormat(() => "")) // Hide Y axis numbers to abstract it
        .attr("color", "#94a3b8");

      svg.append("text")
        .attr("transform", "rotate(-90)")
        .attr("x", -innerHeight / 2)
        .attr("y", -20)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Championship Probability");

      // Line generator
      const line = d3.line<any>()
        .x(d => x(d.age))
        .y(d => y(d.winProb))
        .curve(d3.curveMonotoneX);

      // Draw Path
      const pathLine = svg.append("path")
        .datum(data)
        .attr("fill", "none")
        .attr("stroke", "#eab308")
        .attr("stroke-width", 3)
        .attr("d", line);
        
      const length = pathLine.node().getTotalLength();
      pathLine.attr("stroke-dasharray", length + " " + length)
          .attr("stroke-dashoffset", length)
          .transition()
          .duration(1500)
          .ease(d3.easeCubicOut)
          .attr("stroke-dashoffset", 0);
          
      // Highlight sweet spot
      svg.append("circle")
        .attr("cx", x(27.5))
        .attr("cy", y(85))
        .attr("r", 6)
        .attr("fill", "#22c55e")
        .style("opacity", 0)
        .transition()
        .delay(1000)
        .duration(500)
        .style("opacity", 1);
        
      svg.append("line")
        .attr("x1", x(27.5))
        .attr("y1", y(85))
        .attr("x2", x(27.5))
        .attr("y2", innerHeight)
        .attr("stroke", "#22c55e")
        .attr("stroke-dasharray", "4,4")
        .style("opacity", 0)
        .transition()
        .delay(1000)
        .duration(500)
        .style("opacity", 1);
        
      svg.append("text")
        .attr("x", x(27.5))
        .attr("y", y(85) - 20)
        .attr("fill", "#22c55e")
        .attr("text-anchor", "middle")
        .style("font-size", "14px")
        .text("Peak Age (27.5)")
        .style("opacity", 0)
        .transition()
        .delay(1000)
        .duration(500)
        .style("opacity", 1);
    }
  }
</script>
