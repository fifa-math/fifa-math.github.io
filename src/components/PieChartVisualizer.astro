---
// src/components/PieChartVisualizer.astro
---
<div class="piechart-container" role="figure" aria-label="PieChartVisualizer Data Visualization" class="w-full h-[500px] border border-gray-200 rounded-lg bg-slate-800 relative flex justify-center items-center">
  <div id="pie-tooltip" class="absolute hidden bg-slate-900 text-white p-2 rounded text-sm pointer-events-none z-10 border border-slate-700 shadow-xl"></div>
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.piechart-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const tooltip = container.querySelector('#pie-tooltip') as HTMLElement;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      const radius = Math.min(width, height) / 2 - 40;

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${width / 2},${height / 2})`);

      const data = [
        { label: "Inside Box (Open Play)", value: 55, color: "#3b82f6" },
        { label: "Outside Box (Open Play)", value: 12, color: "#8b5cf6" },
        { label: "Headers (Open Play)", value: 10, color: "#ec4899" },
        { label: "Penalties", value: 9, color: "#f43f5e" },
        { label: "Direct Free Kicks", value: 4, color: "#f59e0b" },
        { label: "Corners (Headers/Volleys)", value: 7, color: "#10b981" },
        { label: "Own Goals", value: 3, color: "#64748b" }
      ];

      const pie = d3.pie<any>()
        .value(d => d.value)
        .sort(null);

      const arc = d3.arc<any>()
        .innerRadius(radius * 0.5) // Donut chart
        .outerRadius(radius);

      const arcs = svg.selectAll("arc")
        .data(pie(data))
        .enter()
        .append("g")
        .attr("class", "arc");

      arcs.append("path")
        .attr("d", arc)
        .attr("fill", d => d.data.color)
        .attr("stroke", "#1e293b")
        .style("stroke-width", "2px")
        .style("opacity", 0)
        .transition()
        .duration(1000)
        .delay((d, i) => i * 100)
        .style("opacity", 0.9);

      // Re-select to add events after transition
      svg.selectAll("path")
        .on("mouseover", (event, d: any) => {
          d3.select(event.currentTarget).style("opacity", 1);
          if(tooltip) {
            tooltip.style.display = "block";
            tooltip.innerHTML = `<strong>${d.data.label}</strong><br/>${d.data.value}% of goals`;
          }
        })
        .on("mousemove", (event) => {
          if(tooltip) {
            const rect = container.getBoundingClientRect();
            tooltip.style.left = (event.clientX - rect.left + 10) + "px";
            tooltip.style.top = (event.clientY - rect.top + 10) + "px";
          }
        })
        .on("mouseout", (event) => {
          d3.select(event.currentTarget).style("opacity", 0.9);
          if(tooltip) {
            tooltip.style.display = "none";
          }
        });

      // Add labels for larger slices
      arcs.append("text")
        .attr("transform", d => `translate(${arc.centroid(d)})`)
        .attr("text-anchor", "middle")
        .text(d => d.data.value > 5 ? `${d.data.value}%` : "")
        .style("fill", "#ffffff")
        .style("font-size", "14px")
        .style("font-weight", "bold")
        .style("pointer-events", "none")
        .style("opacity", 0)
        .transition()
        .delay(1000)
        .duration(500)
        .style("opacity", 1);
        
      // Center text
      svg.append("text")
        .attr("text-anchor", "middle")
        .attr("y", -5)
        .text("Goal")
        .style("fill", "#94a3b8")
        .style("font-size", "16px");
        
      svg.append("text")
        .attr("text-anchor", "middle")
        .attr("y", 15)
        .text("Anatomy")
        .style("fill", "#94a3b8")
        .style("font-size", "16px");
    }
  });
</script>
