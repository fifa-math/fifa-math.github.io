---
// src/components/GameTheoryVisualizer.astro
---
<div class="game-theory-container" role="figure" aria-label="GameTheoryVisualizer Data Visualization" class="w-full h-[400px] border border-gray-200 rounded-lg bg-slate-800 relative flex justify-center items-center overflow-hidden">
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.game-theory-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      const margin = {top: 20, right: 120, bottom: 20, left: 120};
      
      const innerWidth = width - margin.left - margin.right;
      const innerHeight = height - margin.top - margin.bottom;

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // Game Theory Probability Tree (Network Diagram)
      const data = {
        name: "Coin Toss",
        children: [
          {
            name: "Team A (Shoots First)",
            children: [
              { name: "Scores (73% Base)", size: 73, color: "#22c55e" },
              { name: "Misses (27%)", size: 27, color: "#ef4444" }
            ]
          },
          {
            name: "Team B (Shoots Second)",
            children: [
              { name: "Scores (62% Under Pressure)", size: 62, color: "#22c55e" },
              { name: "Misses (38%)", size: 38, color: "#ef4444" }
            ]
          }
        ]
      };

      const root = d3.hierarchy(data);
      
      const treeLayout = d3.tree().size([innerHeight, innerWidth]);
      treeLayout(root);

      // Links (Lines connecting nodes)
      const link = svg.selectAll(".link")
        .data(root.links())
        .enter()
        .append("path")
        .attr("class", "link")
        .attr("fill", "none")
        .attr("stroke", "#94a3b8")
        .attr("stroke-width", 2)
        .attr("d", d3.linkHorizontal()
          .x(d => (d as any).y)
          .y(d => (d as any).x)
        );

      const length = link.node()?.getTotalLength() || 1000;
      link.attr("stroke-dasharray", length + " " + length)
          .attr("stroke-dashoffset", length)
          .transition()
          .duration(1500)
          .ease(d3.easeCubicOut)
          .attr("stroke-dashoffset", 0);

      // Nodes (Circles)
      const node = svg.selectAll(".node")
        .data(root.descendants())
        .enter()
        .append("g")
        .attr("class", d => "node" + (d.children ? " node--internal" : " node--leaf"))
        .attr("transform", d => `translate(${(d as any).y},${(d as any).x})`);

      node.append("circle")
        .attr("r", 0)
        .attr("fill", d => (d.data as any).color || "#3b82f6")
        .transition()
        .delay(1000)
        .duration(500)
        .attr("r", 8);

      // Labels
      node.append("text")
        .attr("dy", 3)
        .attr("x", d => d.children ? -12 : 12)
        .style("text-anchor", d => d.children ? "end" : "start")
        .attr("fill", "#cbd5e1")
        .style("font-size", "14px")
        .text(d => (d.data as any).name)
        .style("opacity", 0)
        .transition()
        .delay(1500)
        .duration(500)
        .style("opacity", 1);
        
      // Summary Label
      svg.append("text")
        .attr("x", innerWidth / 2)
        .attr("y", innerHeight + 10)
        .attr("fill", "#f59e0b")
        .attr("text-anchor", "middle")
        .style("font-size", "16px")
        .text("Team A overall Win Probability: ~60%")
        .style("opacity", 0)
        .transition()
        .delay(2000)
        .style("opacity", 1);
    }
  });
</script>
