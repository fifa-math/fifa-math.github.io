---
// src/components/DensityVisualizer.astro
---
<div class="density-container w-full h-[400px] border border-gray-200 rounded-lg bg-slate-800 relative" role="figure" aria-label="DensityVisualizer Data Visualization">
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.density-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      const margin = {top: 40, right: 30, bottom: 50, left: 60};
      
      const innerWidth = width - margin.left - margin.right;
      const innerHeight = height - margin.top - margin.bottom;

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // Goal probability vs Possession Duration (seconds)
      // Probability spikes early (counter attack), then decays as the defense sets up.
      const data = d3.range(0, 61).map(seconds => {
        // High spike around 5-10 seconds, then exponential decay
        const prob = Math.max(0, 15 * Math.exp(-0.08 * seconds) * (seconds / 5));
        return { seconds, prob };
      });

      const x = d3.scaleLinear()
        .domain([0, 60])
        .range([0, innerWidth]);

      const y = d3.scaleLinear()
        .domain([0, 5]) // Just an abstract probability scale
        .range([innerHeight, 0]);

      // X Axis
      svg.append("g")
        .attr("transform", `translate(0,${innerHeight})`)
        .call(d3.axisBottom(x).tickFormat(d => d + "s"))
        .attr("color", "#94a3b8");

      svg.append("text")
        .attr("x", innerWidth / 2)
        .attr("y", innerHeight + 40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Possession Duration (Seconds)");

      // Y Axis
      svg.append("g")
        .call(d3.axisLeft(y).tickFormat(() => "")) // Hide Y axis numbers
        .attr("color", "#94a3b8");

      svg.append("text")
        .attr("transform", "rotate(-90)")
        .attr("x", -innerHeight / 2)
        .attr("y", -20)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Goal Probability");

      const line = d3.line<any>()
        .x(d => x(d.seconds))
        .y(d => y(d.prob))
        .curve(d3.curveMonotoneX);

      // Area under curve
      const area = d3.area<any>()
        .x(d => x(d.seconds))
        .y0(innerHeight)
        .y1(d => y(d.prob))
        .curve(d3.curveMonotoneX);

      // Draw Area
      svg.append("path")
        .datum(data)
        .attr("fill", "#10b981")
        .style("opacity", 0)
        .attr("d", area)
        .transition()
        .duration(1500)
        .style("opacity", 0.3);

      // Draw Path
      const pathLine = svg.append("path")
        .datum(data)
        .attr("fill", "none")
        .attr("stroke", "#10b981")
        .attr("stroke-width", 3)
        .attr("d", line);
        
      const length = pathLine.node().getTotalLength();
      pathLine.attr("stroke-dasharray", length + " " + length)
          .attr("stroke-dashoffset", length)
          .transition()
          .duration(1500)
          .ease(d3.easeCubicOut)
          .attr("stroke-dashoffset", 0);
          
      // Highlight optimal transition window
      svg.append("rect")
        .attr("x", x(5))
        .attr("y", 0)
        .attr("width", x(15) - x(5))
        .attr("height", innerHeight)
        .attr("fill", "#f59e0b")
        .style("opacity", 0)
        .transition()
        .delay(1000)
        .duration(500)
        .style("opacity", 0.1);
        
      svg.append("text")
        .attr("x", x(10))
        .attr("y", 20)
        .attr("fill", "#f59e0b")
        .attr("text-anchor", "middle")
        .style("font-size", "12px")
        .text("Transition Window")
        .style("opacity", 0)
        .transition()
        .delay(1000)
        .duration(500)
        .style("opacity", 1);
    }
  });
</script>
