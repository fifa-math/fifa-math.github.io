---
// src/components/KitColorVisualizer.astro
---
<div class="kit-color-container" role="figure" aria-label="Kit Color Luminance Visualization" class="w-full h-[400px] border border-gray-200 rounded-lg bg-green-700 relative overflow-hidden flex flex-col items-center p-4">
  <div class="z-10 flex space-x-2 bg-slate-900/80 p-2 rounded-lg border border-slate-700 mb-4">
    <button id="btn-red" class="px-3 py-1 bg-red-600 hover:bg-red-500 text-white text-sm font-semibold rounded transition-colors">Red Kit (High Contrast)</button>
    <button id="btn-grey" class="px-3 py-1 bg-slate-500 hover:bg-slate-400 text-white text-sm font-semibold rounded transition-colors">Grey Kit (Low Contrast)</button>
  </div>
  
  <div class="z-10 bg-slate-900/80 p-3 rounded-lg border border-slate-700 text-center mb-2">
    <div class="text-sm text-gray-300">Relative Luminance Contrast (L = 0.2126R + 0.7152G + 0.0722B)</div>
    <div id="contrast-score" class="text-2xl font-bold text-white mt-1">Calculating...</div>
  </div>

  <div id="pitch-area" class="w-full flex-1 relative"></div>
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.kit-color-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const pitchArea = container.querySelector('#pitch-area');
      if (!pitchArea) return;
      
      const width = pitchArea.clientWidth;
      const height = pitchArea.clientHeight;

      const svg = d3.select(pitchArea)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`);

      // Pitch lines
      svg.append("line")
        .attr("x1", width / 2)
        .attr("y1", 0)
        .attr("x2", width / 2)
        .attr("y2", height)
        .attr("stroke", "rgba(255,255,255,0.4)")
        .attr("stroke-width", 2);
        
      svg.append("circle")
        .attr("cx", width / 2)
        .attr("cy", height / 2)
        .attr("r", 40)
        .attr("fill", "none")
        .attr("stroke", "rgba(255,255,255,0.4)")
        .attr("stroke-width", 2);

      // Random player positions
      const players = Array.from({ length: 8 }, () => ({
        x: Math.random() * (width - 40) + 20,
        y: Math.random() * (height - 40) + 20
      }));

      const circles = svg.selectAll("circle.player")
        .data(players)
        .enter()
        .append("circle")
        .attr("class", "player")
        .attr("cx", d => d.x)
        .attr("cy", d => d.y)
        .attr("r", 12)
        .attr("fill", "#dc2626")
        .attr("stroke", "#ffffff")
        .attr("stroke-width", 2)
        .style("filter", "drop-shadow(0px 4px 4px rgba(0,0,0,0.5))");

      const scoreDisplay = container.querySelector('#contrast-score');
      
      // Calculate contrast ratio between two hex colors (simplified)
      // Green turf approx: #15803d -> rgb(21, 128, 61)
      const getLuminance = (r: number, g: number, b: number) => {
        const a = [r, g, b].map(v => {
          v /= 255;
          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
        });
        return a[0] * 0.2126 + a[1] * 0.7152 + a[2] * 0.0722;
      };
      
      const turfLum = getLuminance(21, 128, 61);
      
      function updateColor(hex: string, rgb: [number, number, number], name: string) {
        circles.transition().duration(500).attr("fill", hex);
        const playerLum = getLuminance(rgb[0], rgb[1], rgb[2]);
        const contrast = (Math.max(turfLum, playerLum) + 0.05) / (Math.min(turfLum, playerLum) + 0.05);
        
        if (scoreDisplay) {
          scoreDisplay.textContent = `${name}: ${contrast.toFixed(2)}:1 Ratio`;
          scoreDisplay.className = `text-2xl font-bold mt-1 ${contrast > 3 ? 'text-green-400' : 'text-red-400'}`;
        }
      }

      const btnRed = container.querySelector('#btn-red');
      const btnGrey = container.querySelector('#btn-grey');

      btnRed?.addEventListener('click', () => {
        updateColor('#dc2626', [220, 38, 38], 'Red Kit');
        btnRed.classList.replace('bg-slate-700', 'bg-red-600');
        btnRed.classList.replace('hover:bg-slate-600', 'hover:bg-red-500');
        btnGrey?.classList.replace('bg-slate-500', 'bg-slate-700');
        btnGrey?.classList.replace('hover:bg-slate-400', 'hover:bg-slate-600');
      });

      btnGrey?.addEventListener('click', () => {
        updateColor('#64748b', [100, 116, 139], 'Grey Kit');
        btnGrey.classList.replace('bg-slate-700', 'bg-slate-500');
        btnGrey.classList.replace('hover:bg-slate-600', 'hover:bg-slate-400');
        btnRed?.classList.replace('bg-red-600', 'bg-slate-700');
        btnRed?.classList.replace('hover:bg-red-500', 'hover:bg-slate-600');
      });

      // Initial state
      updateColor('#dc2626', [220, 38, 38], 'Red Kit');
    }
  });
</script>
