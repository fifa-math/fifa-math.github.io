---
// src/components/BoxPlotVisualizer.astro
---
<div class="boxplot-container" role="figure" aria-label="BoxPlotVisualizer Data Visualization" class="w-full h-[400px] border border-gray-200 rounded-lg bg-slate-800 relative">
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.boxplot-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      const margin = {top: 20, right: 30, bottom: 40, left: 60};
      
      const innerWidth = width - margin.left - margin.right;
      const innerHeight = height - margin.top - margin.bottom;

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // Positions and their height stats (min, q1, median, q3, max) in cm
      const data = [
        { position: "Goalkeeper", min: 185, q1: 188, median: 191, q3: 193, max: 199 },
        { position: "Center Back", min: 180, q1: 185, median: 188, q3: 191, max: 196 },
        { position: "Full Back", min: 168, q1: 174, median: 178, q3: 182, max: 186 },
        { position: "Midfielder", min: 165, q1: 172, median: 177, q3: 183, max: 190 },
        { position: "Winger", min: 166, q1: 172, median: 175, q3: 180, max: 185 },
        { position: "Striker", min: 170, q1: 180, median: 184, q3: 188, max: 195 }
      ];

      const x = d3.scaleBand()
        .range([0, innerWidth])
        .domain(data.map(d => d.position))
        .paddingInner(0.2)
        .paddingOuter(0.5);

      const y = d3.scaleLinear()
        .domain([160, 205])
        .range([innerHeight, 0]);

      // X Axis
      svg.append("g")
        .attr("transform", `translate(0,${innerHeight})`)
        .call(d3.axisBottom(x))
        .attr("color", "#94a3b8");

      // Y Axis
      svg.append("g")
        .call(d3.axisLeft(y).tickFormat(d => d + " cm"))
        .attr("color", "#94a3b8");

      const boxWidth = Math.min(x.bandwidth(), 60); // Cap width for aesthetics

      // Draw vertical lines
      svg.selectAll("vertLines")
        .data(data)
        .enter()
        .append("line")
        .attr("x1", d => x(d.position)! + x.bandwidth() / 2)
        .attr("x2", d => x(d.position)! + x.bandwidth() / 2)
        .attr("y1", d => y(d.min))
        .attr("y2", d => y(d.max))
        .attr("stroke", "#94a3b8")
        .style("width", boxWidth);

      // Draw boxes
      svg.selectAll("boxes")
        .data(data)
        .enter()
        .append("rect")
        .attr("x", d => x(d.position)! + x.bandwidth() / 2 - boxWidth / 2)
        .attr("y", d => y(d.q3))
        .attr("height", d => y(d.q1) - y(d.q3))
        .attr("width", boxWidth)
        .attr("stroke", "#3b82f6")
        .style("fill", "#1e293b")
        .transition()
        .duration(1000)
        .style("fill", "#3b82f6")
        .style("fill-opacity", 0.5);

      // Draw median, min, max lines
      svg.selectAll("medianLines")
        .data(data)
        .enter()
        .append("line")
        .attr("x1", d => x(d.position)! + x.bandwidth() / 2 - boxWidth / 2)
        .attr("x2", d => x(d.position)! + x.bandwidth() / 2 + boxWidth / 2)
        .attr("y1", d => y(d.median))
        .attr("y2", d => y(d.median))
        .attr("stroke", "#ef4444")
        .style("stroke-width", 2);

      svg.selectAll("minLines")
        .data(data)
        .enter()
        .append("line")
        .attr("x1", d => x(d.position)! + x.bandwidth() / 2 - boxWidth / 4)
        .attr("x2", d => x(d.position)! + x.bandwidth() / 2 + boxWidth / 4)
        .attr("y1", d => y(d.min))
        .attr("y2", d => y(d.min))
        .attr("stroke", "#94a3b8");

      svg.selectAll("maxLines")
        .data(data)
        .enter()
        .append("line")
        .attr("x1", d => x(d.position)! + x.bandwidth() / 2 - boxWidth / 4)
        .attr("x2", d => x(d.position)! + x.bandwidth() / 2 + boxWidth / 4)
        .attr("y1", d => y(d.max))
        .attr("y2", d => y(d.max))
        .attr("stroke", "#94a3b8");
    }
  });
</script>
