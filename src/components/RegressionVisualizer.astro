---
// src/components/RegressionVisualizer.astro
---
<div class="regression-container" role="figure" aria-label="RegressionVisualizer Data Visualization" class="w-full h-[400px] border border-gray-200 rounded-lg bg-slate-800 relative">
</div>

<script>
  import * as d3 from 'd3';

  document.querySelectorAll('.regression-container:not(.initialized)').forEach(container => {
    container.classList.add('initialized');
    let hasRendered = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasRendered) {
          hasRendered = true;
          renderChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    function renderChart() {
      const width = container.clientWidth;
      const height = container.clientHeight;
      const margin = {top: 40, right: 30, bottom: 50, left: 60};
      
      const innerWidth = width - margin.left - margin.right;
      const innerHeight = height - margin.top - margin.bottom;

      const svg = d3.select(container)
        .append('svg')
        .attr('width', '100%')
        .attr('height', '100%')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .append('g')
        .attr('transform', `translate(${margin.left},${margin.top})`);

      // Data representing a player's goal output variance vs xG over 38 games
      // They heavily overperform early (high variance), then suffer a drought (low variance), balancing to the mean.
      
      const x = d3.scaleLinear().domain([1, 38]).range([0, innerWidth]);
      const y = d3.scaleLinear().domain([0, 1]).range([innerHeight, 0]);

      // X Axis (Game Week)
      svg.append("g")
        .attr("transform", `translate(0,${innerHeight})`)
        .call(d3.axisBottom(x).tickValues([1, 10, 19, 28, 38]))
        .attr("color", "#94a3b8");
        
      svg.append("text")
        .attr("x", innerWidth / 2)
        .attr("y", innerHeight + 40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Matchweek (Time)");

      // Y Axis (Goals/xG per game)
      svg.append("g")
        .call(d3.axisLeft(y).ticks(5))
        .attr("color", "#94a3b8");
        
      svg.append("text")
        .attr("transform", "rotate(-90)")
        .attr("x", -innerHeight / 2)
        .attr("y", -40)
        .attr("fill", "#94a3b8")
        .attr("text-anchor", "middle")
        .text("Goals / xG");

      // The Mean (Expected Goals - xG) -> Constant 0.5 per game
      svg.append("line")
        .attr("x1", 0)
        .attr("y1", y(0.5))
        .attr("x2", innerWidth)
        .attr("y2", y(0.5))
        .attr("stroke", "#f59e0b")
        .attr("stroke-width", 3)
        .attr("stroke-dasharray", "5,5")
        .style("opacity", 0)
        .transition()
        .duration(1000)
        .style("opacity", 1);
        
      svg.append("text")
        .attr("x", innerWidth - 20)
        .attr("y", y(0.5) - 10)
        .attr("fill", "#f59e0b")
        .attr("text-anchor", "end")
        .style("font-size", "14px")
        .text("True xG Mean (0.5)");

      // Violin Plot / Distribution generation to represent Volatility Range
      // We will create a shape that starts wide (high variance) and narrows down to the mean
      const areaData = d3.range(1, 39).map(gw => {
        // Variance decreases over time (Law of Large Numbers visualization abstract)
        const variance = Math.max(0.05, 0.4 * Math.exp(-0.08 * gw));
        return {
          gw: gw,
          y0: 0.5 - variance,
          y1: 0.5 + variance
        };
      });

      const area = d3.area<any>()
        .x(d => x(d.gw))
        .y0(d => y(d.y0))
        .y1(d => y(d.y1))
        .curve(d3.curveBasis);

      svg.append("path")
        .datum(areaData)
        .attr("fill", "#3b82f6")
        .attr("opacity", 0.2)
        .attr("d", area)
        .style("opacity", 0)
        .transition()
        .delay(500)
        .duration(1500)
        .style("opacity", 0.2);

      // Actual Goals scored (Volatile line snapping to mean)
      const goalsData = [
        {gw: 1, val: 0.1},
        {gw: 4, val: 0.9}, // Massive overperformance
        {gw: 8, val: 0.75},
        {gw: 13, val: 0.2}, // Drought begins
        {gw: 18, val: 0.15},
        {gw: 24, val: 0.55},
        {gw: 30, val: 0.45},
        {gw: 38, val: 0.5}  // Converges to mean
      ];

      const line = d3.line<any>()
        .x(d => x(d.gw))
        .y(d => y(d.val))
        .curve(d3.curveMonotoneX);

      const pathLine = svg.append("path")
        .datum(goalsData)
        .attr("fill", "none")
        .attr("stroke", "#ffffff")
        .attr("stroke-width", 3)
        .attr("d", line);
        
      const length = pathLine.node().getTotalLength();
      pathLine.attr("stroke-dasharray", length + " " + length)
          .attr("stroke-dashoffset", length)
          .transition()
          .delay(1000)
          .duration(2000)
          .ease(d3.easeCubicOut)
          .attr("stroke-dashoffset", 0);

      // Scatter points
      svg.selectAll("circle")
        .data(goalsData)
        .enter()
        .append("circle")
        .attr("cx", d => x(d.gw))
        .attr("cy", d => y(d.val))
        .attr("r", 5)
        .attr("fill", "#ffffff")
        .style("opacity", 0)
        .transition()
        .delay(1000)
        .duration(2000)
        .style("opacity", 1);
        
      // Labels for points
      svg.append("text").attr("x", x(4)).attr("y", y(0.9) - 15).attr("fill", "#fff").attr("text-anchor", "middle").style("font-size", "12px").text("Hot Streak").style("opacity", 0).transition().delay(2500).style("opacity", 1);
      svg.append("text").attr("x", x(18)).attr("y", y(0.15) + 20).attr("fill", "#fff").attr("text-anchor", "middle").style("font-size", "12px").text("Goal Drought").style("opacity", 0).transition().delay(2500).style("opacity", 1);
    }
  });
</script>
